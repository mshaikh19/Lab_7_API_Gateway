# ================================================================
#  CampusConnect - Service Registry / Environment Configuration
#  (Part B: Configuration-based Service Discovery)
#
#  Copy this file to .env (for local development outside Docker)
#  or set these as environment variables on your cloud platform.
#
#  In Docker Compose these are injected via the `environment:`
#  block in compose.yaml - no code change is needed to re-point
#  the gateway to a different service location.
# ================================================================

# ── API Gateway ───────────────────────────────────────────────
GATEWAY_PORT=3000

# ── Service Registry ──────────────────────────────────────────
# These three variables form the lightweight service registry.
# The gateway reads them at startup and builds its routing table.
# To move a service to a different host/port, only this file
# (or the cloud env config) needs to change - no code edit.

# Local Docker network (default)
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# ── Cloud Deployment (Render / Railway / Fly.io) ─────────────
# Uncomment and replace with your actual cloud service URLs:
# USER_SERVICE_URL=https://campusconnect-user.onrender.com
# PRODUCT_SERVICE_URL=https://campusconnect-product.onrender.com
# ORDER_SERVICE_URL=https://campusconnect-order.onrender.com

# ── MongoDB Atlas (replace for cloud deployment) ──────────────
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
